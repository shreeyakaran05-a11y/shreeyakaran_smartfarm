1. Define a class Student with data members
A class is a user-defined data type that combines data members and member functions into a single unit. A class Student can store details such as roll number, name and marks.
#include <iostream>
using namespace std;

class Student
{
public:
    int roll;
    string name;
    float marks;

    void display()
    {
        cout << "Roll Number: " << roll << endl;
        cout << "Name: " << name << endl;
        cout << "Marks: " << marks << endl;
    }
};

int main()
{
    Student s1;

    s1.roll = 101;
    s1.name = "Rahul";
    s1.marks = 85.5;

    s1.display();

    return 0;
output-
Roll Number: 101
Name: Rahul
Marks: 85.5

